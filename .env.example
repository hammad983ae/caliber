# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Firebase client SDK (https://console.firebase.google.com -> Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase admin SDK. Generate at: Project settings -> Service accounts -> Generate new private key
# Either set the whole JSON as one variable:
FIREBASE_SERVICE_ACCOUNT_KEY=
# ...or set these three individually (e.g. as Vercel's Firebase integration does):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Shared by both Google connectors below — register BOTH redirect URIs on the
# same OAuth client, and enable the Google Calendar API and Google Sheets API
# on the project (APIs & Services -> Library):
#   <your-app-url>/api/connectors/google-calendar/callback
#   <your-app-url>/api/connectors/google-sheets/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secures the scheduled automation runner (see vercel.json). Vercel automatically
# sends this as `Authorization: Bearer <value>` when it invokes the Cron Job, so
# no manual wiring is needed beyond setting this — generate any random string.
CRON_SECRET=

# Powers the create-automation chat's real intent parsing (Gemini's free tier).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
